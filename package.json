{
  "name": "new-vector-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "admin:setup": "node scripts/admin-credentials.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
