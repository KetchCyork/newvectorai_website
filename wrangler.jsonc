{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newvectorai-website",
  "main": "server/worker.js",
  "account_id": "20a76b4061a4c9dbd5f156d2f01b5ba8",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "newvectorai-website",
    "database_id": "fbf9071c-2f65-48ec-8a92-5ebb80671cda",
    "migrations_dir": "drizzle"
  }],
  "routes": [
    {"pattern": "newvectorai.net", "custom_domain": true},
    {"pattern": "www.newvectorai.net/*", "zone_name": "newvectorai.net"}
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "traces": {"enabled": true}}
}
